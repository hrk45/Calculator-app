pipeline {
    agent any
    stages {
                stage('mvn clean build')
                {
                    steps
                    {
                        bat 'mvn clean install'
                    }
                }
                stage('Docker Build & Push') {
                    steps {
                        withCredentials([usernamePassword(credentialsId: 'dockerhub-cred',
                                                        usernameVariable: 'DOCKER_USER',
                                                        passwordVariable: 'DOCKER_PASS')]) {
                            bat """
                            echo %DOCKER_PASS% | docker login -u %DOCKER_USER% --password-stdin
                            docker build -t calculator-app:latest -f calculator/Dockerfile calculator/
                            docker tag calculator-app:latest %DOCKER_USER%/calculator-app:latest
                            docker push %DOCKER_USER%/calculator-app:latest
                            """
                        }
                    }
                }
    }
}
